<?xml version="1.0" encoding="utf-8"?>
<!-- Paired hosts and their tokens stay on this phone: not in cloud backups,
     not copied to a new phone (the Keystore key that seals the token can't
     follow anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fairspoken.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fairspoken.xml" />
    </device-transfer>
</data-extraction-rules>

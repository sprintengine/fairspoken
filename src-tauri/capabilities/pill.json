{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pill",
  "description": "The recording pill (main window): registers the recording and copied-messages global shortcuts",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}

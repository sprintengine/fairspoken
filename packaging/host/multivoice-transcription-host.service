# Runs the MultiVoice transcription host as a systemd user service.
# Install: see "Running the host on a Tailscale network" in README.md.
[Unit]
Description=MultiVoice transcription host
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=%h/.local/bin/transcription-host
Environment=MULTIVOICE_HOST_ADDR=127.0.0.1:48173
EnvironmentFile=%h/.config/multivoice-tauri/host.env
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

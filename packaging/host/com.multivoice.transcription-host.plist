<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the MultiVoice transcription host as a per-user launch agent.
  Install: see "Running the host on a Tailscale network" in README.md.
  Replace __BINARY__, __TOKEN__ and __LOG_DIR__ before loading.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.multivoice.transcription-host</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BINARY__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MULTIVOICE_HOST_ADDR</key>
    <string>127.0.0.1:48173</string>
    <key>MULTIVOICE_HOST_TOKEN</key>
    <string>__TOKEN__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/transcription-host.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/transcription-host.log</string>
</dict>
</plist>
